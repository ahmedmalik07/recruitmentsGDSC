# ---------------------------------------------------------------------------
# GDG Quest environment variables
# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Firebase web config (admin panel only; safe to expose) -----------------
# Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only, NEVER prefix with NEXT_PUBLIC_) --------
# Project settings → Service accounts → Generate new private key (JSON)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value in double quotes, keeping the \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare Turnstile ----------------------------------------------------
# Cloudflare dashboard → Turnstile → Add widget (add your Vercel domain + localhost)
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# If both are empty, local dev skips the bot check. Production REQUIRES the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Applications deadline (optional) ----------------------------------------
# Leave empty to keep applications open. Example: 2026-11-01T23:59:00+05:00
# ISO 8601 with timezone (PKT is +05:00). Read by both the UI and /api/apply.
# NEXT_PUBLIC_ values are baked in at build time: redeploy after changing it.
NEXT_PUBLIC_APPLICATIONS_DEADLINE=

# --- Admin access -------------------------------------------------------------
# People on these lists get admin access automatically the first time they sign in
# to /admin with Google. Comma separated. Leads also need their house after a colon.
# Houses: technical | marketing_partnerships | creatives | media | ops
# (scripts/set-claims.ts still works too, and is how you remove access.)
ADMIN_CORE_EMAILS=
ADMIN_LEAD_EMAILS=

# --- Optional: confirmation email via Resend ---------------------------------
# Leave RESEND_API_KEY empty to disable emails entirely.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "GDGOC AU <quest@yourdomain.com>"
RESEND_FROM_EMAIL=
