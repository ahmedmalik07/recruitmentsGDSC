rules_version = '2';

// GDG Quest
// Browsers get NO direct access to the database. Everything goes through the server:
//   /api/apply      candidates submit (validated, bot-checked)
//   /api/admin/*    admins read and update (Google sign-in + role checked on every request)
// The server uses the Firebase Admin SDK, which is not affected by these rules.
// So nobody can read, change or delete applications from a browser console, ever.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
